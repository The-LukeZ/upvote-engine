# Cloudflare D1 (used by drizzle.config.ts for `pnpm drizzle:generate` / remote migrations)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Discord application credentials
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_APP_SECRET=
DISCORD_TOKEN=

# AES-GCM key used by Cryptor to encrypt/decrypt forwarding secrets and owner OAuth tokens
ENCRYPTION_KEY=

# Top.gg bot stats API token (posted to top.gg on the weekly cron)
TOP_GG_TOKEN=
TOP_GG_CLIENT_ID=
TOP_GG_CLIENT_SECRET=

# Discord user ID allowed to run owner-only commands/actions
OWNER_ID=

# Guild ID admin-only commands are registered to (optional, leave empty for none)
ADMIN_GUILD_ID=
