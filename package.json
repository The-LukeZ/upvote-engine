{
  "name": "upvote-engine",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bulk-secrets": "wrangler secret bulk .env",
    "docs:dev": "pnpm --filter docs-site dev",
    "docs:build": "pnpm --filter docs-site build",
    "deploy": "pnpm docs:build && wrangler deploy",
    "build": "pnpm docs:build && wrangler types && wrangler build",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "gen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "register": "tsx --env-file=.env src/registerCommands.ts",
    "migrate": "wrangler d1 migrations apply vote_handler --remote --migrations-dir drizzle/migrations",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config drizzle.config.ts",
    "test": "vitest",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/collection": "^2.1.1",
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@honocord/cache-do": "^0.3.1",
    "@sapphire/snowflake": "^3.5.5",
    "dayjs": "^1.11.23",
    "discord-api-types": "^0.38.55",
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "honocord": "^3.0.1",
    "topgg-api-types": "^2.3.1",
    "zod": "^4.6.0"
  },
  "license": "Elastic-2.0",
  "packageManager": "pnpm@11.23.0"
}
